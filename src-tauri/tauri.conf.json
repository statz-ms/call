{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Statz",
  "version": "1.3.5",
  "identifier": "com.statz.desktop",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "npm start"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Statz",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
